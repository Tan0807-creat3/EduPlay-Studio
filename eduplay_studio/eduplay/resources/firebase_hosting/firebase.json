{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/support", "destination": "/support.html" },
      { "source": "/support/addin", "destination": "/support-addin.html" },
      { "source": "/support/addin/**", "destination": "/support-addin.html" },
      { "source": "/support/app", "destination": "/support-app.html" },
      { "source": "/support/app/**", "destination": "/support-app.html" },
      { "source": "/support/**", "destination": "/support.html" },
      { "source": "/privacy", "destination": "/privacy.html" },
      { "source": "/privacy/**", "destination": "/privacy.html" },
      { "source": "/terms", "destination": "/terms.html" },
      { "source": "/terms/**", "destination": "/terms.html" },
      { "source": "/ppt-addin/taskpane.html", "destination": "/ppt-addin/taskpane.html" },
      { "source": "/ppt-addin/taskpane.js", "destination": "/ppt-addin/taskpane.js" },
      { "source": "/ppt-addin/content.html", "destination": "/ppt-addin/content.html" },
      { "source": "/ppt-addin/content.js", "destination": "/ppt-addin/content.js" },
      { "source": "/ppt-addin/commands.html", "destination": "/ppt-addin/commands.html" },
      { "source": "/ppt-addin/manifest-taskpane.xml", "destination": "/ppt-addin/manifest-taskpane.xml" },
      { "source": "/ppt-addin/manifest-content.xml", "destination": "/ppt-addin/manifest-content.xml" },
      { "source": "/ppt-addin/icon.png", "destination": "/ppt-addin/icon.png" },
      { "source": "/ppt-addin/icon.svg", "destination": "/ppt-addin/icon.svg" },
      { "source": "**", "destination": "/firebase_viewer.html" }
    ],
    "headers": [
      {
        "source": "/firebase_viewer.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/support.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/support-addin.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/support-app.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/privacy.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/terms.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/ppt-addin/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
